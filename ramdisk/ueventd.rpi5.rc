# Bluetooth
/dev/rfkill                                                                  0660   bluetooth  bluetooth

# Camera
/dev/media*                                                                  0660   system     camera
/dev/v4l-subdev*                                                             0660   system     camera
/dev/video*                                                                  0660   system     camera

# CEC
/dev/cec0                                                                    0660   system     graphics
/dev/cec1                                                                    0660   system     graphics

# DMA
/dev/dma_heap/linux,cma                                                      0666   system     graphics

# FFmpeg
/dev/media0                                                                  0660   media      media
/dev/video19                                                                 0660   media      media

# USB
/sys/class/udc/1000480000.usb  current_speed                                 0664   system     system

# Modem (SIM7600 USB serial ports: the car client reads NMEA and AT through vendor_modem). The glob takes every
# USB serial port, so a second ttyUSB device (an ELM327 for OBD-II, whose notes ask for a rule on the same glob)
# needs its own name or the same group first: ueventd takes the last matching rule.
/dev/ttyUSB*                                                                 0660   root       vendor_modem
